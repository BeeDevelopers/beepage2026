# URL absoluta del sitio público. Completar antes de desplegar.
# En desarrollo puede quedar vacía: los módulos usan la URL local.
NUXT_SITE_URL=

# En staging, establecer NUXT_SITE_INDEXABLE=false.
# En desarrollo, Nuxt Robots bloquea la indexación automáticamente.

# Credenciales de Supabase para el formulario de registro + bucket de fotos (solo servidor).
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=
NUXT_SUPABASE_BUCKET=registros-fotos
NUXT_SUPABASE_TABLE=registros
